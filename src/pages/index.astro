---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import GameSearch from '../components/GameSearch.astro';
import Pagination from '../components/Pagination.astro';
import { getDatabase } from '../lib/db';
import {getAllGames, getGamesPage } from '../lib/games';

export const prerender = true;

const PAGE_SIZE = 6;

const db = getDatabase();

const { games, page, totalPages } = await getGamesPage(db, {
  page: 1,
  limit: PAGE_SIZE,
});

const allGames = await getAllGames(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">
        Featured Games
      </h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
         <GameSearch  />

          <div
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
            data-testid="games-grid"
          >
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <template id="all-games-template">
                {allGames.map((game) => <GameCard game={game} />)}
          </template>

          <p
            class="mt-8 text-center text-slate-400"
            data-testid="game-search-empty"
            hidden
          >
            No games found.
          </p>

          <Pagination currentPage={page} totalPages={totalPages} />
        </>
      )}
    </div>
  </div>
</Layout>